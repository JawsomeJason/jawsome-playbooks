{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jstack-cli playbook list --json",
  "description": "Every playbook the cascade knows, and what each layer does to it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "owner", "org", "pstack", "layers", "playbooks"],
  "properties": {
    "repo": { "type": ["string", "null"] },
    "owner": { "type": ["string", "null"] },
    "org": { "type": ["string", "null"] },
    "pstack": { "type": "string" },
    "layers": { "type": "array", "items": { "type": "string" }, "description": "Cascade order from layers.json, lowest first." },
    "playbooks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "layers"],
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string", "description": "pstack for a bundled playbook, else the layer that defines the standalone playbook." },
          "layers": {
            "type": "object",
            "description": "One key per cascade layer.",
            "additionalProperties": { "enum": ["defines", "edits", "none"] }
          }
        }
      }
    }
  }
}
