{
  "schemaVersion": 1,
  "name": "jstack",
  "displayName": "jstack",
  "version": "0.5.0",
  "description": "Layers personal and team playbooks over pstack's poteto-mode playbooks in a fixed cascade, and validates them against each pstack release. Muse port of the Claude Code plugin.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "playbook",
        "path": "skills/playbook/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "setup",
        "path": "skills/setup/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [],
    "hooks": [],
    "mcpServers": [],
    "reminders": []
  }
}
